# Postgres connection string (Sevalla: use the database's internal connection URL)
DATABASE_URL=postgres://user:password@host:5432/eof

# The public HTTPS address people use. Passkeys are bound to this host — pick it once.
PUBLIC_URL=https://eof.example.com

# One-time code to enroll your first passkey. 12+ random characters; remove after setup.
# If unset, a code is generated and printed in the server log on boot.
EOF_SETUP_CODE=

# Port to listen on (Sevalla routes to 8080 by default)
PORT=8080

# Optional: email each day's news edition when it's published (Cloudflare Email Service).
# Leave CLOUDFLARE_EMAIL_TOKEN empty to turn email off. The token needs "Email Sending: Edit".
# Free setup: enable Email Routing on your domain and verify EMAIL_TO as a destination address —
# sends to verified addresses cost nothing on any Cloudflare plan.
CLOUDFLARE_EMAIL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_FROM=news@example.com
EMAIL_FROM_NAME=EOF
EMAIL_TO=you@example.com
